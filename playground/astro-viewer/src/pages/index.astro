---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
const caseHref = `${base}cases/2025/24-109/`;
---

<BaseLayout
  title="SCOTUS Audio Archive"
  description="Static Supreme Court oral argument viewer archive playground."
  bodyClass="archive-body"
>
  <main class="archive-shell">
    <header class="archive-hero">
      <p class="archive-label">Astro playground</p>
      <h1>Supreme Court audio viewers</h1>
      <p>
        Static case viewers generated from processed timeline, speaker profile, and word alignment data.
      </p>
    </header>

    <section class="case-list" aria-label="Available cases">
      <a class="case-card" href={caseHref}>
        <span class="case-term">2025 term</span>
        <strong>Louisiana v. Callais</strong>
        <span>24-109 · argued October 15, 2025 · 150 min</span>
      </a>
    </section>
  </main>
</BaseLayout>
