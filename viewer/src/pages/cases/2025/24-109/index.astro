---
import ViewerShell from "../../../../components/ViewerShell.astro";
import BaseLayout from "../../../../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
const dataRoot = `${base}data/cases/2025/24-109`;
---

<BaseLayout
  title="Louisiana v. Callais · SCOTUS Viewer"
  description="Static viewer for Louisiana v. Callais Supreme Court oral argument audio."
>
  <ViewerShell base={base} dataRoot={dataRoot} />

  <script>
    import "../../../../scripts/viewer.ts";
  </script>
</BaseLayout>
