---
import BaseLayout from "../layouts/BaseLayout.astro";
import ViewerShell from "../components/ViewerShell.astro";

const base = import.meta.env.BASE_URL;
const caseDocket = process.env.SCOTUS_CASE_DOCKET;
const caseTitle = process.env.SCOTUS_CASE_TITLE || `Case ${caseDocket}`;
---

<BaseLayout
  title={caseDocket ? `${caseTitle} · SCOTUS Viewer` : "SCOTUS Transcript Viewer"}
  description="Supreme Court oral argument audio with synchronized transcripts and speaker profiles."
  bodyClass={caseDocket ? undefined : "archive-body"}
>
  {caseDocket ? (
    <ViewerShell base={base} bundleUrl={`${base}bundle.json`} />
  ) : (
    <main class="archive-shell">
      <header class="archive-hero">
        <p class="archive-label">Supreme Court transcripts</p>
        <h1>SCOTUS Transcript Viewer</h1>
        <p>No case is loaded. Open a packaged case viewer to explore its oral argument and transcript.</p>
      </header>
    </main>
  )}
  <script>
    if (document.getElementById("viewer-root")) {
      import("../scripts/viewer");
    }
  </script>
</BaseLayout>
